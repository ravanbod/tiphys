# HTTP server port and the separate Prometheus /metrics port.
PORT=8080
METRICS_PORT=9090

# "debug" (console logs, for local dev) or "release" (JSON logs). Default release.
GIN_MODE=debug
# debug, info, warn, error. Independent of GIN_MODE.
LOG_LEVEL=debug

# External URL of the portal. Required. It is the only Origin accepted on
# WebSockets and is used for the OIDC redirect and notification links.
PUBLIC_URL=http://localhost:8080
# Secure cookie flag; defaults to true when PUBLIC_URL is https.
# COOKIE_SECURE=false

# Keycloak usernames (comma-separated) made admin at EVERY login, whether or not
# the user already exists. It only promotes: removing a name does not demote
# (change the role on the Users page), and an admin demoted there while still
# listed is promoted again at the next login. Matching ignores case.
TIPHYS_BOOTSTRAP_ADMINS=

# Keycloak groups (comma-separated) whose members are made admin at EVERY login.
# It only promotes: leaving the group does not demote (change the role on the
# Users page). Matching ignores case and a leading "/". Needs a group
# membership mapper on the Keycloak client that adds the groups to the ID
# token (claim name below).
TIPHYS_ADMIN_GROUPS=
# ID token claim that lists the user's groups.
# OIDC_GROUPS_CLAIM=groups

# LOCAL DEVELOPMENT ONLY: skip Keycloak. Every visitor is logged in as this
# user: "admin" is made admin (audited) at each login, any other name (e.g.
# developer) is a regular user who needs grants. /login logs in right away and
# the OIDC_* settings are not needed. Unset: Keycloak as usual. Refused with
# GIN_MODE=release. After changing it, log out (or wait up to 5 minutes).
# DEV_LOGIN_USER=admin

# Local users: admins can create users who log in with a password stored
# (bcrypt) in the portal instead of Keycloak, so they skip Keycloak's MFA and
# policies. Their sessions last at most 8 hours. Turning it off stops their
# logins and ends their open sessions within 5 minutes. Default false.
LOCAL_USERS_ENABLED=false

# PostgreSQL. DATABASE_URL is the application role (INSERT/SELECT only on
# audit_events). DATABASE_RETENTION_URL is the retention job's role.
# DATABASE_MIGRATE_URL (owner role), when set, runs migrations at startup.
# See docs/database.md and deploy/sql/roles.sql.
DATABASE_URL=
DATABASE_RETENTION_URL=
DATABASE_MIGRATE_URL=

# Keycloak (confidential client, code flow + PKCE).
OIDC_ISSUER_URL=https://keycloak.example.com/realms/main
OIDC_CLIENT_ID=tiphys
# Secrets: set NAME_FILE (a mounted Kubernetes Secret) or, locally, NAME.
OIDC_CLIENT_SECRET_FILE=
# One or more 32-byte keys (hex or base64), comma-separated. The first
# encrypts; all decrypt, so keys can be rotated.
SESSION_ENCRYPTION_KEYS_FILE=

# Argo CD. The token's account needs get on applications, projects and
# clusters, and sync on applications (the Sync button on the namespace page and
# Roll back in an app's history: Argo CD authorizes a rollback as sync).
ARGO_URL=https://argocd.example.com
# Argo CD's address in the browser, for links to applications (default ARGO_URL).
# ARGO_PUBLIC_URL=
ARGO_TOKEN_FILE=
# ARGO_CA_FILE=
# ARGO_INSECURE_SKIP_VERIFY=false

# MinIO (S3 API) with Object Lock; credentials can put and read but not delete.
MINIO_ENDPOINT=minio.example.com:9000
MINIO_BUCKET=tiphys-recordings
MINIO_ACCESS_KEY_FILE=
MINIO_SECRET_KEY_FILE=
MINIO_USE_SSL=true
# Local development only: create the bucket (with Object Lock) if missing.
# MINIO_ENSURE_BUCKET=true

# Loki (push-only credentials). Optional, but without it audit has no
# immutable copy.
LOKI_URL=
# LOKI_USER=
# LOKI_PASSWORD_FILE=
# LOKI_TOKEN_FILE=
# LOKI_TENANT_ID=

# Where clusters come from. "secrets": every Secret in the portal's namespace
# annotated `tiphys/cluster: <cluster name>`, with the kubeconfig in its
# `kubeconfig` key, is a cluster (the portal only reads them). "dir": every
# <cluster>.kubeconfig file in CREDENTIAL_DIR (local development).
CREDENTIAL_STORE=dir
CREDENTIAL_DIR=./.clusters
# CREDENTIAL_NAMESPACE=tiphys-portal
# MANAGEMENT_KUBECONFIG=   # only when not running in-cluster

# For local testing: also allow adding a cluster (and replacing its credential)
# by pasting a kubeconfig on the Clusters page. The kubeconfig is written to
# CREDENTIAL_DIR, so this needs CREDENTIAL_STORE=dir (the portal refuses to
# start otherwise): the portal never writes Secrets in a cluster. Default false.
CLUSTER_REGISTRATION_FROM_UI=false

# Domain of the impersonation extras; must match the per-cluster chart's extraDomain.
KUBE_EXTRA_DOMAIN=portal.example.com

# Debug containers (the Debug button): image of the ephemeral container the
# portal adds to a pod, pinned by digest. Must equal the chart's debug.image on
# every cluster; clusters without the chart's tiphys-debug-only policy refuse
# debug. Empty (default) turns the feature off.
# DEBUG_IMAGE=nicolaka/netshoot@sha256:<digest>

# Serve the frontend from a directory instead of the embedded build.
# WEB_DIR=./web/dist

# Per-user limit on state-changing requests per minute.
RATE_LIMIT_PER_MINUTE=30
